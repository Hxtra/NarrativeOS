    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
