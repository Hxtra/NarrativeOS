# Flannan Isles video pipeline — environment configuration (example only — placeholders)
# Create a real .env file from this template; never commit real .env files to GitHub

# OpenRouter / TTS provider settings
OPENROUTER_API_KEY=<paste-your-openrouter-api-key-here>
TTS_PROVIDER=fish_audio
TTS_MODEL=S2.1 Pro
TTS_VOICE=male-british

# OpenAI TTS fallback (requires separate OpenAI key — not provided by OpenRouter)
VOICE_TOOLS_OPENAI_KEY=<paste-your-openai-tts-key-here>

# Visual matching / HyperFrames settings
VISUAL_MATCHING_MODE=prototype
HYPERFRAMES_LOADER=blocked
CAPTION_WORKFLOW=ass_subtitles_pending

# Project / pipeline settings
PROJECT_DIR=.
FFMPEG_PATH=<path-to-ffmpeg-binary>
FFPROBE_PATH=<path-to-ffprobe-binary>
